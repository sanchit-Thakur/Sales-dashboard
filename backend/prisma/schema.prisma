// Step 2: Database Schema (Prisma Schema with MySQL / PostgreSQL support)
// Configured with clean relations, Category & Account enums, and indexes for high-speed querying

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
}

enum Category {
  HOUSING
  UTILITIES
  GROCERIES
  DINING
  TRANSPORTATION
  ENTERTAINMENT
  SHOPPING
  SUBSCRIPTIONS
  HEALTH
  INVESTMENT
  SAVINGS
  INCOME
  UNCATEGORIZED
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum RiskTolerance {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  name              String
  preferredCurrency String             @default("USD")
  riskTolerance     RiskTolerance      @default(MODERATE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  accounts          Account[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  investmentProfile InvestmentProfile?
  chatSessions      AdvisorChatSession[]

  @@index([email])
}

model Account {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType
  balance        Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  plaidAccountId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  transactions   Transaction[]

  @@index([userId])
  @@index([plaidAccountId])
}

model Transaction {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount          Decimal     @db.Decimal(12, 2)
  currency        String      @default("USD")
  merchantName    String
  description     String      @db.Text
  rawDescription  String?     @db.Text
  date            DateTime
  category        Category    @default(UNCATEGORIZED)
  isRecurring     Boolean     @default(false)
  isPending       Boolean     @default(false)
  aiCategorized   Boolean     @default(false)
  confidenceScore Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Indexes for high-performance time-series & category aggregation queries
  @@index([userId, date])
  @@index([userId, category])
  @@index([accountId, date])
  @@index([date])
}

model Budget {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category
  monthlyLimit   Decimal  @db.Decimal(12, 2)
  alertThreshold Float    @default(0.80) // 80% limit warning threshold
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Ensure unique budget cap per user per category
  @@unique([userId, category])
  @@index([userId])
}

model Goal {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0.00) @db.Decimal(12, 2)
  currency      String     @default("USD")
  deadline      DateTime?
  category      Category   @default(SAVINGS)
  status        GoalStatus @default(IN_PROGRESS)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, deadline])
}

model InvestmentProfile {
  id                  String        @id @default(uuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlySurplus      Decimal       @db.Decimal(12, 2)
  riskProfile         RiskTolerance @default(MODERATE)
  stocksPct           Float
  bondsPct            Float
  cashPct             Float
  cryptoPct           Float
  recommendedStrategy String        @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model AdvisorChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Financial Advisor Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String             @id @default(uuid())
  sessionId String
  session   AdvisorChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String             // "user", "assistant", "system"
  content   String             @db.Text
  timestamp DateTime           @default(now())

  @@index([sessionId])
}
